#!/bin/bash
# Launch Autodesk Fusion in Docker with the designgears patched Wine.
# Requirements: docker + nvidia-container-toolkit, image built from docker/Dockerfile,
# patched Wine extracted at $WINE_DIR, Fusion installed in $WINEPREFIX.
WINE_DIR="${WINE_DIR:-$HOME/fusion-wine-build}"
WINEPREFIX="${WINEPREFIX:-$HOME/.autodesk_fusion/wineprefixes/default}"
IMAGE="${IMAGE:-fusion-wine:latest}"
EXE=$(find "$WINEPREFIX/drive_c/Program Files/Autodesk/webdeploy/production" -name Fusion360.exe -printf "%T+ %p\n" | sort -r | head -1 | cut -d' ' -f2-)
[ -z "$EXE" ] && { echo "Fusion360.exe not found in $WINEPREFIX"; exit 1; }
docker rm -f fusion360 >/dev/null 2>&1
exec docker run --rm --name fusion360 --gpus all -e NVIDIA_DRIVER_CAPABILITIES=all \
  --network host --ipc host -u "$(id -u):$(id -g)" \
  -e DISPLAY="$DISPLAY" -e XAUTHORITY=/tmp/.Xauthority -v "${XAUTHORITY:-$HOME/.Xauthority}":/tmp/.Xauthority:ro \
  -v /tmp/.X11-unix:/tmp/.X11-unix -v /etc/machine-id:/etc/machine-id:ro \
  -v "$HOME":"$HOME" -w "$HOME" -e HOME="$HOME" -e USER="$USER" \
  -e WINEPREFIX="$WINEPREFIX" -e WINEDEBUG="${WINEDEBUG:--all}" -e WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}" \
  -e DXVK_LOG_LEVEL=none -e DXVK_CONFIG="dxgi.hideNvidiaGpu = False" \
  "$IMAGE" "$WINE_DIR/bin/wine" "$EXE"
